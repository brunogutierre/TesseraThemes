{
  "name": "tessera-themes-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build @brunogutierre/tessera-themes",
    "watch": "ng build @brunogutierre/tessera-themes --watch --configuration development",
    "test": "ng test @brunogutierre/tessera-themes --watch=false",
    "test:watch": "ng test @brunogutierre/tessera-themes",
    "test:coverage": "ng test @brunogutierre/tessera-themes --watch=false --coverage",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "npm run build && publint dist/brunogutierre/tessera-themes && cd dist/brunogutierre/tessera-themes && attw --pack . --profile esm-only && npm pack --dry-run",
    "storybook": "ng run @brunogutierre/tessera-themes:storybook",
    "build-storybook": "ng run @brunogutierre/tessera-themes:build-storybook",
    "test:stories": "node scripts/test-stories.mjs"
  },
  "dependencies": {
    "@angular/aria": "22.2.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@brunogutierre/tessera": "^0.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/angular-vite": "10.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "ng-packagr": "^22.2.6",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
